# Copy to .env for gateway runs outside Docker Compose.
IG_PRIMARY_URL=http://127.0.0.1:8001
IG_FALLBACK_URL=http://127.0.0.1:8002
# Set to triton when running the gateway locally against a Triton primary.
# compose.triton.yaml sets this automatically for its gateway container.
IG_PRIMARY_PROTOCOL=mock
IG_REQUEST_TIMEOUT_SECONDS=1
IG_FAILURE_THRESHOLD=3
IG_RECOVERY_TIMEOUT_SECONDS=10
